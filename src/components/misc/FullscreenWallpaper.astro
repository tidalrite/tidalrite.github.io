---
import Image from "@components/atoms/Image/Image.astro";
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";
import { getImageFormats, getImageQuality } from "../../utils/image-utils";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] =>
		Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

	if (
		typeof srcConfig === "object" &&
		srcConfig !== null &&
		!Array.isArray(srcConfig)
	) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) {
	return null;
}

// 轮播配置
const isCarouselEnabled =
	config.carousel?.enable &&
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;
const wallpaperFormats = getImageFormats();
const wallpaperQuality = getImageQuality();

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top":
			return "object-top";
		case "bottom":
			return "object-bottom";
		default:
			return "object-center";
	}
})();

const renderGroups = [
	{
		key: "desktop",
		images: imageSources.desktop,
		containerClass: "hidden md:block",
		hasImages: hasDesktopImages,
	},
	{
		key: "mobile",
		images: imageSources.mobile,
		containerClass: "block md:hidden",
		hasImages: hasMobileImages,
	},
];
---

<div 
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none wallpaper-container",
		className
	]}
	style={`z-index: ${zIndex}; transform: translateZ(0); perspective: 1000px; opacity: var(--wallpaper-opacity, ${opacity}); filter: blur(var(--wallpaper-blur, ${blurAmount}px));`}
	data-fullscreen-wallpaper
>
	<script is:inline define:vars={{ wallpaperEnabled: config.enable ?? true, overlaySwitchable: config.overlay?.switchable ?? true }}>
	(function() {
		const root = document.documentElement;
		const wallpaperEnabledVal = wallpaperEnabled;
		const mode = wallpaperEnabledVal ? (localStorage.getItem('wallpaperMode') || 'banner') : 'banner';

		if (mode === 'overlay') {
			const isSw = typeof overlaySwitchable === 'object' ? overlaySwitchable : { opacity: !!overlaySwitchable, blur: !!overlaySwitchable, cardOpacity: !!overlaySwitchable };
			const overlayOpacity = isSw.opacity ? localStorage.getItem('overlayOpacity') : null;
			const overlayBlur = isSw.blur ? localStorage.getItem('overlayBlur') : null;
			const overlayCardOpacity = isSw.cardOpacity ? localStorage.getItem('overlayCardOpacity') : null;

			if (overlayOpacity) {
				document.currentScript.parentElement.style.setProperty('--wallpaper-opacity', overlayOpacity);
			}
			if (overlayBlur) {
				document.currentScript.parentElement.style.setProperty('--wallpaper-blur', overlayBlur + 'px');
			}
			if (overlayCardOpacity) {
				root.style.setProperty('--card-transparent-opacity', overlayCardOpacity);
			}
		}

		if (mode !== 'overlay') {
			root.style.removeProperty('--card-transparent-opacity');
			document.currentScript.parentElement.style.display = 'none';
		}
	})();
	</script>

	{renderGroups.map(group => group.hasImages && (
		<div class={`${group.containerClass} w-full h-full relative`} data-wallpaper-group={group.key}>
			{group.images.map((src, index) => (
				<template data-wallpaper-frame={index}>
					<div class={`wallpaper-frame absolute inset-0 w-full h-full transition-opacity duration-1000 ${positionClass}`}>
						<div class="wallpaper-artwork absolute inset-0">
							<div class="wallpaper-artwork-backdrop absolute inset-0" aria-hidden="true">
								<Image src={src} alt="" class="w-full h-full" position={position} widths={group.key === "mobile" ? [640, 1024, 1536] : [1024, 1536, 2048, 2560]} sizes="100vw" loading="lazy" fetchpriority="low" quality={group.key === "mobile" ? Math.round(wallpaperQuality * 0.9) : wallpaperQuality} formats={wallpaperFormats} overlay={false} />
							</div>
							<div class="wallpaper-artwork-foreground relative z-10 h-full w-full">
								<Image src={src} alt={`${group.key} wallpaper ${index + 1}`} class="w-full h-full" position={position} widths={group.key === "mobile" ? [640, 1024, 1536] : [1024, 1536, 2048, 2560]} sizes="100vw" loading="lazy" fetchpriority="low" quality={group.key === "mobile" ? Math.round(wallpaperQuality * 0.9) : wallpaperQuality} formats={wallpaperFormats} overlay={false} />
							</div>
						</div>
					</div>
				</template>
			))}
		</div>
	))}
</div>

<style is:global>
	/* 覆盖 / 全屏壁纸：完整展示原图，模糊放大的同图补足屏幕空白。 */
	.wallpaper-artwork {
		background: #11131d;
	}

	.wallpaper-artwork-backdrop {
		overflow: hidden;
		background: #11131d;
	}

	.wallpaper-artwork-backdrop > div {
		height: 100%;
		width: 100%;
		transform: scale(1.12);
		filter: blur(1.5rem);
	}

	.wallpaper-artwork-backdrop::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: rgb(7 9 18 / 0.18);
	}

	.wallpaper-artwork-foreground > div {
		height: 100%;
		width: 100%;
	}

	.wallpaper-artwork-foreground img {
		object-fit: contain !important;
		filter: drop-shadow(0 1rem 2rem rgb(0 0 0 / 0.35));
	}
</style>

<script is:inline define:vars={{ carouselInterval, carouselEnabled: !!isCarouselEnabled, wallpaperEnabled: config.enable ?? true }}>
	function initFullscreenWallpaperCarousel() {
		const root = document.querySelector('[data-fullscreen-wallpaper]');
		if (!root) return;

		if (window.__wallpaper_cleanup) {
			window.__wallpaper_cleanup();
			window.__wallpaper_cleanup = null;
		}

		const STORAGE_KEY = 'mizuki_wallpaper_index';
		const groups = Array.from(root.querySelectorAll('[data-wallpaper-group]')).map((group) => ({
			key: group.dataset.wallpaperGroup,
			node: group,
			frames: Array.from(group.querySelectorAll('template[data-wallpaper-frame]')),
			mounted: new Map(),
			currentIndex: 0,
			timer: null,
			busy: false,
			activating: false,
			generation: 0,
		}));
		let activeGroup = null;
		let disposed = false;
		const desktopQuery = window.matchMedia('(min-width: 768px)');

		function currentMode() {
			return wallpaperEnabled ? (localStorage.getItem('wallpaperMode') || 'banner') : 'banner';
		}

		function removeMountedFrame(group, index, expected) {
			const mounted = group.mounted.get(index);
			if (!mounted || (expected && mounted !== expected)) return;
			mounted.cancelReady?.();
			mounted.node.querySelectorAll('img, source').forEach((media) => {
				media.removeAttribute('src');
				media.removeAttribute('srcset');
			});
			mounted.node.remove();
			group.mounted.delete(index);
		}

		function stopGroup(group, clearFrames = true) {
			group.generation += 1;
			if (group.timer !== null) {
				clearTimeout(group.timer);
				group.timer = null;
			}
			if (clearFrames) {
				for (const index of group.mounted.keys()) removeMountedFrame(group, index);
			}
			group.busy = false;
			group.activating = false;
		}

		function isActive(group) {
			return !disposed && !document.hidden && root.isConnected && currentMode() === 'overlay' &&
				(group.key === 'desktop' ? desktopQuery.matches : !desktopQuery.matches);
		}

		function mountFrame(group, index) {
			const existing = group.mounted.get(index);
			if (existing) return existing;
			const template = group.frames[index];
			if (!template) return null;

			const frame = document.createElement('div');
			frame.className = 'wallpaper-frame absolute inset-0 w-full h-full transition-opacity duration-1000';
			frame.style.opacity = '0';
			frame.appendChild(template.content.cloneNode(true));
			const images = Array.from(frame.querySelectorAll('img'));
			for (const image of images) {
				image.loading = 'eager';
				image.decoding = 'async';
				image.fetchPriority = 'low';
			}
			group.node.appendChild(frame);
			let cancelReady = () => {};
			const ready = new Promise((resolve) => {
				let settled = false;
				const decoded = new WeakSet();
				const decoding = new WeakSet();
				const timeoutId = setTimeout(() => finish(false), 12000);
				function finish(ok) {
					if (settled) return;
					settled = true;
					clearTimeout(timeoutId);
					for (const image of images) {
						image.removeEventListener('load', checkImage);
						image.removeEventListener('error', failImage);
					}
					resolve(ok);
				}
				let pending = images.length;
				function checkImage() {
					if (decoded.has(this) || decoding.has(this)) return;
					if (this.naturalWidth === 0) return failImage();
					if (typeof this.decode === 'function') {
						decoding.add(this);
						this.decode().then(() => {
							decoded.add(this);
							pending -= 1;
							if (pending === 0) finish(true);
						}, () => {
							if (this.naturalWidth > 0) {
								decoded.add(this);
								pending -= 1;
								if (pending === 0) finish(true);
							} else finish(false);
						});
					} else {
						decoded.add(this);
						pending -= 1;
						if (pending === 0) finish(true);
					}
				}
				function failImage() { finish(false); }
				cancelReady = () => finish(false);
				if (pending === 0) finish(false);
				for (const image of images) {
					image.addEventListener('load', checkImage);
					image.addEventListener('error', failImage);
					if (image.complete) checkImage.call(image);
				}
			});
			const mounted = { node: frame, ready };
			mounted.cancelReady = cancelReady;
			group.mounted.set(index, mounted);
			return mounted;
		}

		function preloadNext(group) {
			if (!carouselEnabled || group.frames.length < 2 || !isActive(group)) return;
			const nextIndex = (group.currentIndex + 1) % group.frames.length;
			const next = mountFrame(group, nextIndex);
			if (next) next.ready.then((ok) => {
				if (!ok && group.mounted.has(nextIndex) && nextIndex !== group.currentIndex) {
					removeMountedFrame(group, nextIndex, next);
				}
			});
		}

		function scheduleNext(group) {
			if (!carouselEnabled || group.frames.length < 2 || !isActive(group)) return;
			group.timer = setTimeout(() => switchToNext(group), Math.max(1500, carouselInterval * 1000));
		}

		async function switchToNext(group) {
			group.timer = null;
			if (!isActive(group) || group.busy || group.frames.length < 2) return;
			group.busy = true;
			const generation = group.generation;
			const oldIndex = group.currentIndex;
			for (let offset = 1; offset < group.frames.length; offset += 1) {
				if (!isActive(group) || generation !== group.generation) break;
				const nextIndex = (oldIndex + offset) % group.frames.length;
				const next = mountFrame(group, nextIndex);
				if (!next) continue;
				const ready = await next.ready;
				if (!ready || !isActive(group) || generation !== group.generation) {
					if (!ready) removeMountedFrame(group, nextIndex, next);
					continue;
				}
				const old = group.mounted.get(oldIndex);
				next.node.style.opacity = '1';
				if (old) {
					old.node.style.opacity = '0';
					setTimeout(() => {
						removeMountedFrame(group, oldIndex, old);
						if (generation === group.generation && isActive(group)) {
							preloadNext(group);
							scheduleNext(group);
						}
					}, 1050);
				}
				group.currentIndex = nextIndex;
				try { sessionStorage.setItem(STORAGE_KEY, String(nextIndex)); } catch {}
				group.busy = false;
				if (!old) {
					preloadNext(group);
					scheduleNext(group);
				}
				return;
			}
			group.busy = false;
			scheduleNext(group);
		}

		async function activate(group) {
			if (!group.frames.length || !isActive(group)) return;
			stopGroup(group);
			activeGroup = group;
			const generation = group.generation;
			group.activating = true;
			let initialIndex = 0;
			try {
				const stored = Number.parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
				if (Number.isInteger(stored) && stored >= 0 && stored < group.frames.length) initialIndex = stored;
			} catch {}
			group.currentIndex = initialIndex;
			for (let offset = 0; offset < group.frames.length; offset += 1) {
				if (!isActive(group) || generation !== group.generation) return;
				const index = (initialIndex + offset) % group.frames.length;
				const mounted = mountFrame(group, index);
				if (!mounted) continue;
				if (await mounted.ready && isActive(group) && generation === group.generation) {
					group.activating = false;
					group.currentIndex = index;
					mounted.node.style.opacity = '1';
					try { sessionStorage.setItem(STORAGE_KEY, String(index)); } catch {}
					preloadNext(group);
					scheduleNext(group);
					return;
				}
				removeMountedFrame(group, index, mounted);
			}
			if (generation === group.generation) group.activating = false;
		}

		function syncActiveGroup() {
			if (document.hidden || currentMode() !== 'overlay' || !wallpaperEnabled || !root.isConnected) {
				for (const group of groups) stopGroup(group);
				activeGroup = null;
				return;
			}
			const desired = groups.find((group) => group.key === (desktopQuery.matches ? 'desktop' : 'mobile'));
			if (desired === activeGroup && (desired?.mounted.size || desired?.activating)) return;
			for (const group of groups) if (group !== desired) stopGroup(group);
			if (desired) activate(desired);
		}

		const handleModeChange = () => syncActiveGroup();
		const handleVisibilityChange = () => syncActiveGroup();
		const handleBreakpointChange = () => syncActiveGroup();
		const handlePageView = () => syncActiveGroup();
		window.addEventListener('wallpaper-mode-change', handleModeChange);
		document.addEventListener('visibilitychange', handleVisibilityChange);
		document.addEventListener('swup:page:view', handlePageView);
		desktopQuery.addEventListener?.('change', handleBreakpointChange);
		window.addEventListener('resize', handleBreakpointChange);
		syncActiveGroup();

		window.__wallpaper_cleanup = () => {
			disposed = true;
			for (const group of groups) stopGroup(group);
			window.removeEventListener('wallpaper-mode-change', handleModeChange);
			document.removeEventListener('visibilitychange', handleVisibilityChange);
			document.removeEventListener('swup:page:view', handlePageView);
			desktopQuery.removeEventListener?.('change', handleBreakpointChange);
			window.removeEventListener('resize', handleBreakpointChange);
		};
	}

	// 页面加载完成后初始化轮播
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFullscreenWallpaperCarousel);
	} else {
		initFullscreenWallpaperCarousel();
	}
</script>
